
class Main {
    public static void main(String[] args) {
        String text = "geeksforgeeks";
        String pattern = "geeks";

        for (int i = 0; i <= text.length() - pattern.length(); i++) {
            int j;

            for (j = 0; j < pattern.length(); j++) {
                if (text.charAt(i + j) != pattern.charAt(j))
                    break;
            }

            if (j == pattern.length())
                System.out.print(i + " ");
        }
    }
}
