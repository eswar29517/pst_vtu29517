
import java.util.*;

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        int count = 0;

        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) != "SOS".charAt(i % 3))
                count++;
        }

        System.out.println(count);
        sc.close();
    }
}
